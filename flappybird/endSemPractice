let bird;
let bg;

function preload() {
    bg = loadImage("assets/background-night.png");
    bird = loadImage("assets/bluebird-midflap.png");
}

function setup(){
    new Canvas(600,400);
    background(bg);

    bird = new Sprite();
    bird.x = 300;
    bird.y = 200;
    bird.img = bird;
    bird.mass = 2;
}