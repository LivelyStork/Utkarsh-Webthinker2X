let bird;
let bg;

function preload() {
    bg = loadImage("assets/background-night.png");
    bird = loadImage("assets/bluebird-midflap.png");
}

function setup(){
    new Canvas(600,400);
    background("white");

    bird = new Sprite();
    bird.x = 300;
    bird.y = 200;
    bird.img = bird;
    bird.mass = 2;
    world.gravity.y = 10;
}

function draw(){
    background(bg, 0, 0, width, height);
    if (mouse.presses()){
        bird.velocity.y += 5;
    }
}